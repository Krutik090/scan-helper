PORT=4567
MONGODB_URI=mongodb://localhost:27017/ThreatIntel
AMASS_BIN=/usr/lib/amass/amass

# Primary tool (faster, better passive results).
# Install: go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest
# Then set the path below (usually ~/go/bin/subfinder or /root/go/bin/subfinder)
SUBFINDER_BIN=/home/krutik/go/bin/subfinder

# Amass fallback timeout in minutes
SCAN_TIMEOUT_MINUTES=5
